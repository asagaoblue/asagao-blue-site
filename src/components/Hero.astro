---
---

<section class="relative pt-20 pb-28 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto overflow-hidden">
  <!-- Background Glow & Grid -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[400px] bg-gradient-to-tr from-indigo-600/20 via-sky-500/15 to-purple-600/20 blur-[130px] rounded-full pointer-events-none -z-10"></div>
  
  <div class="text-center max-w-4xl mx-auto">
    <!-- Release Announcement Pill -->
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-indigo-500/10 border border-indigo-500/25 text-indigo-300 text-xs font-medium mb-8 hover:bg-indigo-500/15 transition-all cursor-pointer">
      <span class="flex h-2 w-2 rounded-full bg-indigo-400 animate-ping"></span>
      <span class="font-semibold text-white">New</span>
      <span>自律型マルチエージェント連携機能 v2.5 提供開始</span>
      <svg class="w-3.5 h-3.5 text-indigo-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    </div>

    <!-- Main Headline -->
    <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight leading-[1.1] mb-6">
      ビジネスのすべてを、<br />
      <span class="text-gradient">自律型AIワークフロー</span>で加速する。
    </h1>

    <!-- Subheadline -->
    <p class="text-base sm:text-xl text-slate-300 max-w-2xl mx-auto leading-relaxed mb-10 font-normal">
      NebulaFlow は、LLM・社内データベース・業務SaaSを直感的なパイプラインで統合。
      複雑なビジネスプロセスを24時間稼働のAIエージェントチームへ安全に委託します。
    </p>

    <!-- Call to Actions -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16">
      <a href="#contact" class="w-full sm:w-auto px-7 py-3.5 rounded-xl bg-gradient-to-r from-indigo-500 to-indigo-600 hover:from-indigo-600 hover:to-indigo-700 text-white font-semibold text-sm shadow-xl shadow-indigo-600/30 hover:scale-[1.02] active:scale-[0.98] transition-all flex items-center justify-center gap-2">
        <span>無料トライアルを開始</span>
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
      <a href="#features" class="w-full sm:w-auto px-7 py-3.5 rounded-xl glass-panel hover:bg-slate-800/80 text-slate-200 font-semibold text-sm border border-slate-700/80 hover:scale-[1.02] active:scale-[0.98] transition-all flex items-center justify-center gap-2">
        <span>機能デモを見る</span>
        <svg class="w-4 h-4 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/></svg>
      </a>
    </div>

    <!-- Micro trust factors -->
    <div class="flex flex-wrap items-center justify-center gap-6 text-xs text-slate-400">
      <span class="flex items-center gap-1.5">
        <svg class="w-4 h-4 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
        クレジットカード登録不要
      </span>
      <span class="flex items-center gap-1.5">
        <svg class="w-4 h-4 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
        最短3分でセットアップ完了
      </span>
      <span class="flex items-center gap-1.5">
        <svg class="w-4 h-4 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
        SOC2 Type II / ISO27001 準拠
      </span>
    </div>
  </div>

  <!-- Product UI Mockup / Dashboard Preview -->
  <div class="mt-16 relative max-w-5xl mx-auto">
    <div class="glass-panel-glow rounded-2xl overflow-hidden shadow-2xl border border-indigo-500/30">
      <!-- Window Titlebar -->
      <div class="bg-slate-900/90 border-b border-slate-800 px-4 py-3 flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-rose-500/80"></span>
          <span class="w-3 h-3 rounded-full bg-amber-500/80"></span>
          <span class="w-3 h-3 rounded-full bg-emerald-500/80"></span>
          <span class="ml-2 text-xs font-mono text-slate-400">NebulaFlow Studio - Customer_Onboarding_Pipeline.flow</span>
        </div>
        <div class="flex items-center gap-3 text-xs text-slate-400 font-mono">
          <span class="flex items-center gap-1.5 text-emerald-400">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            Agent Active
          </span>
          <span class="px-2 py-0.5 rounded bg-slate-800 text-slate-300">v2.5.1</span>
        </div>
      </div>

      <!-- App Interface Content -->
      <div class="p-6 bg-slate-950/90 grid grid-cols-1 md:grid-cols-3 gap-6 font-mono text-xs">
        <!-- Node 1: Ingestion -->
        <div class="glass-panel p-4 rounded-xl border border-slate-800 flex flex-col gap-3 relative group hover:border-indigo-500/50 transition-colors">
          <div class="flex items-center justify-between">
            <span class="text-indigo-400 font-semibold flex items-center gap-1.5">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12"/></svg>
              01. Event Trigger
            </span>
            <span class="text-[10px] bg-indigo-500/10 text-indigo-300 px-2 py-0.5 rounded border border-indigo-500/20">Webhook</span>
          </div>
          <p class="text-slate-400 font-sans text-xs">HubSpot / Salesforce の商談成立イベントを即時リッスン</p>
          <div class="bg-slate-900 p-2.5 rounded-lg border border-slate-800 text-[11px] text-slate-300">
            <code>{'payload: { deal_id: "D-9481", ARR: "$120,000" }'}</code>
          </div>
        </div>

        <!-- Node 2: AI Agent Processing -->
        <div class="glass-panel p-4 rounded-xl border border-indigo-500/40 bg-indigo-950/20 flex flex-col gap-3 relative group shadow-lg shadow-indigo-950/50">
          <div class="flex items-center justify-between">
            <span class="text-sky-300 font-semibold flex items-center gap-1.5">
              <svg class="w-4 h-4 text-sky-400 animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
              02. AI Orchestrator
            </span>
            <span class="text-[10px] bg-sky-500/20 text-sky-300 px-2 py-0.5 rounded border border-sky-500/30">Autonomous</span>
          </div>
          <p class="text-slate-400 font-sans text-xs">契約書PDFの解析、Slackチャンネル自動開設、請求書自動起票</p>
          <div class="bg-slate-900/90 p-2.5 rounded-lg border border-slate-800 text-[11px] text-emerald-400">
            <code>✓ 契約条項の抽出完了 (信頼度 99.8%)</code>
          </div>
        </div>

        <!-- Node 3: Execution & Sync -->
        <div class="glass-panel p-4 rounded-xl border border-slate-800 flex flex-col gap-3 relative group hover:border-indigo-500/50 transition-colors">
          <div class="flex items-center justify-between">
            <span class="text-purple-400 font-semibold flex items-center gap-1.5">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14M22 4L12 14.01l-3-3"/></svg>
              03. Multi-Sync Output
            </span>
            <span class="text-[10px] bg-purple-500/10 text-purple-300 px-2 py-0.5 rounded border border-purple-500/20">Finished</span>
          </div>
          <p class="text-slate-400 font-sans text-xs">Notion顧客台帳作成、カレンダー初回キックオフMTG自動提案</p>
          <div class="bg-slate-900 p-2.5 rounded-lg border border-slate-800 text-[11px] text-slate-300">
            <code>status: SUCCESS (処理時間: 1.4秒)</code>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Logos / Trusted By Section -->
  <div class="mt-20 pt-10 border-t border-slate-800/80 text-center">
    <p class="text-xs uppercase tracking-widest text-slate-300 font-semibold mb-8">
      急成長スタートアップから上場エンタープライズまで 500社以上で導入検証中
    </p>
    <div class="flex flex-wrap items-center justify-center gap-8 sm:gap-14 opacity-60 grayscale hover:grayscale-0 transition-all duration-300">
      <span class="font-bold text-lg tracking-wider text-slate-300">✦ CYBERNEXUS</span>
      <span class="font-bold text-lg tracking-wider text-slate-300">◈ QUANTUM LABS</span>
      <span class="font-bold text-lg tracking-wider text-slate-300">▲ APEX DYNAMICS</span>
      <span class="font-bold text-lg tracking-wider text-slate-300">● STRATA FLOW</span>
      <span class="font-bold text-lg tracking-wider text-slate-300">◆ LUMEN TECH</span>
    </div>
  </div>
</section>
