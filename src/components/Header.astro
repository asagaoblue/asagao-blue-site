---
---

<header class="sticky top-7 z-40 w-full px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto pt-3">
  <div class="glass-panel rounded-2xl px-5 py-3.5 flex items-center justify-between shadow-2xl shadow-indigo-950/40 border border-slate-800/80">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-3 group">
      <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-indigo-600 via-indigo-500 to-sky-400 flex items-center justify-center shadow-lg shadow-indigo-500/25 group-hover:scale-105 transition-transform duration-300">
        <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
        </svg>
      </div>
      <div class="flex flex-col">
        <span class="font-bold text-lg tracking-tight text-white flex items-center gap-1.5">
          Asagao Blue
          <span class="text-[10px] uppercase tracking-wider px-1.5 py-0.5 rounded-full bg-cyan-500/10 text-cyan-300 border border-cyan-500/30 font-semibold font-mono">.Inc</span>
        </span>
        <span class="text-[10px] text-slate-400 tracking-wider">株式会社 Asagao Blue</span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-300">
      <a href="#features" class="hover:text-indigo-400 transition-colors">製品機能</a>
      <a href="#metrics" class="hover:text-indigo-400 transition-colors">導入効果</a>
      <a href="#pricing" class="hover:text-indigo-400 transition-colors">料金プラン</a>
      <a href="#company" class="hover:text-indigo-400 transition-colors">会社情報</a>
      <a href="#contact" class="hover:text-indigo-400 transition-colors">お問い合わせ</a>
    </nav>

    <!-- Header Action Buttons -->
    <div class="flex items-center gap-3">
      <a href="#contact" class="hidden sm:inline-flex text-xs font-semibold text-slate-300 hover:text-white px-3.5 py-2 rounded-lg hover:bg-slate-800/60 transition-colors">
        資料請求
      </a>
      <a href="#pricing" class="inline-flex items-center justify-center text-xs font-semibold px-4 py-2 rounded-xl bg-gradient-to-r from-indigo-500 to-indigo-600 hover:from-indigo-600 hover:to-indigo-700 text-white shadow-lg shadow-indigo-600/30 hover:shadow-indigo-600/50 hover:scale-[1.02] active:scale-[0.98] transition-all duration-200">
        14日間無料体験
      </a>
    </div>
  </div>
</header>
