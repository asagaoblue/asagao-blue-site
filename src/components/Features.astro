  {
    icon: `<path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm1 14.5V13h-2v3.5a1.5 1.5 0 0 1-3 0V11a5 5 0 0 1 10 0v5.5a1.5 1.5 0 0 1-3 0z"/>`,
    tag: "AI Core",
    title: "自律型マルチエージェント連携",
    description: "複数の特化型AIエージェント（リサーチャー、ライター、コーダー、アナリスト）が協調自律動作。複雑な多段階業務を人間レベルの精度で遂行します。"
  },
  {
    icon: `<path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>`,
    tag: "Integrations",
    title: "100+ の業務SaaSと即座に接続",
    description: "Google Workspace, Slack, Notion, GitHub, Salesforce, HubSpot などの主要ツールと認証キーのみで即時連携。複雑なAPIコードの記述は不要です。"
  },
  {
    icon: `<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>`,
    tag: "Security",
    title: "エンタープライズ水準のセキュリティ",
    description: "SOC2 Type II、ISO27001基準に準拠。入力データはモデルの学習に一切使用されず、エンドツーエンドの暗号化（AES-256）とアクセス権限制御を徹底。"
  },
  {
    icon: `<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/>`,
    tag: "No-Code Builder",
    title: "自然言語からのパイプライン自動生成",
    description: "「顧客からの問い合わせメールを分類し、Slackに要約を飛ばして返信下書きを作る」と日本語で指示するだけで、実行可能なワークフロー図を瞬時に自動構築。"
  },
  {
    icon: `<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>`,
    tag: "Governance",
    title: "Human-in-the-loop（人間の承認制御）",
    description: "高リスクな処理（メール一斉送信、DB更新、決済承認など）には人間の確認ステップを必須化。完全自動化と安全性管理をスマートに両立します。"
  },
  {
    icon: `<line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/>`,
    tag: "Analytics",
    title: "リアルタイム実行分析 & ログ監査",
    description: "ワークフローごとの実行時間、API消費コスト、削減時間（ROI）、エラーログを直感的なダッシュボードで一元監視。常にボトルネックを可視化します。"
  }
];
---

<section id="features" class="py-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto relative">
  <!-- Section Heading -->
  <div class="text-center max-w-3xl mx-auto mb-16">
    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 text-xs font-semibold mb-4">
      Core Features
    </div>
    <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight mb-4">
      すべての業務を、<span class="text-gradient">知的自律化</span>するテクノロジー
    </h2>
    <p class="text-slate-400 text-base leading-relaxed">
      Asagao Blue は、単なる自動化ツールではありません。AI が文脈を理解し、判断し、実行する次世代のワークフォース・プラットフォームです。
    </p>
  </div>

  <!-- Feature Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {features.map((item) => (
      <div class="glass-panel p-7 rounded-2xl border border-slate-800/80 hover:border-indigo-500/40 transition-all duration-300 hover:-translate-y-1 group">
        <div class="flex items-center justify-between mb-5">
          <div class="w-12 h-12 rounded-xl bg-indigo-600/15 text-indigo-400 border border-indigo-500/25 flex items-center justify-center group-hover:scale-110 group-hover:bg-indigo-600 group-hover:text-white transition-all duration-300">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={item.icon}></svg>
          </div>
          <span class="text-[11px] font-mono font-semibold px-2.5 py-0.5 rounded-full bg-slate-800 text-slate-300 border border-slate-700">
            {item.tag}
          </span>
        </div>
        <h3 class="text-lg font-bold text-white mb-2 group-hover:text-indigo-300 transition-colors">
          {item.title}
        </h3>
        <p class="text-slate-400 text-sm leading-relaxed">
          {item.description}
        </p>
      </div>
    ))}
  </div>
</section>
